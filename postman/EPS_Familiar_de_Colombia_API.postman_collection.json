    {
      "name": "Procesos IPS",
      "description": "Agendamiento, historia clínica y autorización IPS por orden médica (solicitud + activación). Medicamentos: requiere `autoriza_med`.",
      "item": [
        {
          "name": "Crear agendamiento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sede\": \"SEDE_01\",\n  \"tipoDoc\": \"CC\",\n  \"numDoc\": \"1234567890\",\n  \"tipoDoc_Prof\": \"CC\",\n  \"numDoc_Prof\": \"987654321\",\n  \"fecha_cita\": \"2026-05-25\",\n  \"hora_cita\": \"08:30:00\",\n  \"especialidad\": \"Medicina general\",\n  \"estado\": 0\n}"
            },
            "url": "{{baseUrl}}/agendamientos"
          }
        },
        {
          "name": "Actualizar el estado de un agendamiento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": 1\n}"
            },
            "url": "{{baseUrl}}/agendamientos/{{id_agendamiento}}"
          }
        },
        {
          "name": "Registrar historia clínica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Prestador\": { \"Identificacion\": \"900123456\" },\n  \"EntidadResponsable\": {\n    \"Codigo\": \"CCF033\",\n    \"PlanBeneficios\": \"PLAN01\",\n    \"ValorCopagoCuotaModeradora\": \"0\"\n  },\n  \"Usuario\": {\n    \"TipoIdentificacion\": \"CC\",\n    \"Identificacion\": \"1234567890\"\n  },\n  \"Cita\": {\n    \"FechaAtencion\": \"2026-05-22\",\n    \"CodigoCups\": \"890201\",\n    \"CodigoCausaExterna\": 13,\n    \"CodigoDiagnosticoPrincipal\": \"Z000\"\n  },\n  \"Mediciones\": {\n    \"Peso\": 70,\n    \"Talla\": 170,\n    \"PerimetroAbdominal\": 80,\n    \"Tasistolica\": 120,\n    \"Tadiastolica\": 80,\n    \"EdadDeLaMenarquia\": 0,\n    \"EdadMenopausiaPnal\": 0,\n    \"IMC\": \"24.2\"\n  },\n  \"Actividades\": [\n    {\n      \"Profesional\": {\n        \"Identificacion\": \"987654321\",\n        \"TipoIdentificacion\": \"CC\"\n      },\n      \"ValorConsultaProcedimiento\": \"50000\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/historia_clinica"
          }
        },
        {
          "name": "Registrar historia clínica vía HL7 FHIR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bundle\": {\n    \"resourceType\": \"Bundle\",\n    \"type\": \"collection\",\n    \"entry\": []\n  },\n  \"historia_clinica_pdf_base64\": \"JVBERi0xLjQKJeLjz9MKMSAwIG9iago8PC9UeXBlL0NhdGFsb2cvUGFnZXMgMiAwIFI+PmVuZG9iagolLi4uIHRyYW5jYWRvCiUlRU9G\"\n}"
            },
            "url": "{{baseUrl}}/historia_clinica/hl7",
            "description": "Reemplace `bundle` por un Bundle FHIR R4 válido y el PDF en Base64."
          }
        },
        {
          "name": "Registrar solicitud de autorización IPS (orden médica)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "tipo_identificacion", "value": "{{tipo_identificacion}}", "type": "text", "description": "CC, TI, CE, etc." },
                { "key": "numero_identificacion", "value": "{{numero_identificacion}}", "type": "text" },
                { "key": "observacion", "value": "{{observacion_solicitud}}", "type": "text", "description": "Obligatorio (texto de la solicitud)." },
                { "key": "email", "value": "", "type": "text", "description": "Opcional; sede → afiliado → IPS.", "disabled": true },
                { "key": "telefono", "value": "{{telefono_contacto}}", "type": "text", "description": "Obligatorio. Formato 9999999999." },
                { "key": "celular", "value": "{{celular_contacto}}", "type": "text", "description": "Obligatorio. Formato 9999999999." },
                { "key": "prioridad_atencion", "value": "{{prioridad_atencion}}", "type": "text", "description": "integer (smallint) — default 1. Solo dígitos." },
                { "key": "justificacion_clinica", "value": "", "type": "text", "description": "Opcional.", "disabled": true },
                { "key": "diagnostico_principal", "value": "{{diagnostico_principal}}", "type": "text", "description": "CIE-10 obligatorio (tb_cie10)." },
                { "key": "diagnostico_relacionado_1", "value": "{{diagnostico_relacionado_1}}", "type": "text", "description": "CIE-10 opcional.", "disabled": true },
                { "key": "diagnostico_relacionado_2", "value": "{{diagnostico_relacionado_2}}", "type": "text", "description": "CIE-10 opcional.", "disabled": true },
                { "key": "nit_ips_prestador", "value": "{{nit_ips_prestador}}", "type": "text", "description": "NIT prestador solicitante (CT_IPS)." },
                { "key": "nit_ips_direccionamiento", "value": "{{nit_ips_direccionamiento}}", "type": "text", "description": "NIT donde se autoriza; CUM en tarifario del municipio del afiliado." },
                { "key": "consecutivo_sede_ips", "value": "{{consecutivo_sede_ips}}", "type": "text", "description": "integer — ct_ips_sede.consecutivo_sede_ips. Disabled = primera sede.", "disabled": true },
                { "key": "telefono_institucional_extension", "value": "", "type": "text", "description": "Opcional.", "disabled": true },
                { "key": "prestador_solicitante", "value": "", "type": "text", "description": "Opcional si envía nit_ips_prestador.", "disabled": true },
                { "key": "municipio_prestador", "value": "", "type": "text", "description": "Opcional; autocompleta desde sede/IPS.", "disabled": true },
                { "key": "fecha_solicitud_proceso", "value": "{{fecha_solicitud_proceso}}", "type": "text", "description": "date — ss_solicitud.fecha_solicitud_proceso. YYYY-MM-DD, ≤ hoy." },
                { "key": "fecha_solicitud_medico", "value": "{{fecha_solicitud_medico}}", "type": "text", "description": "date — ss_solicitud.fecha_solicitud_medico. YYYY-MM-DD, ≤ hoy." },
                { "key": "registro_profesional", "value": "{{registro_profesional}}", "type": "text", "description": "Obligatorio. Autocompleta nombre, cargo, especialidad, tipo/número ID (tb_medico_solicitante)." },
                {
                  "key": "medicamentos_json",
                  "value": "[{\"cum\":\"13874-1\",\"cantidad\":1,\"dias\":30,\"observacion\":\"Uso segun orden medica\"}]",
                  "type": "text",
                  "description": "Por ítem: cum (obligatorio), cantidad, dias, observacion. Posología desde tb_medicamento. No repetir CUM. Segundo ítem de prueba no autorizado: agregue {\"cum\":\"99999-X\",...}."
                },
                { "key": "soporte_orden_medica", "type": "file", "src": [], "description": "PDF obligatorio. Máx. ORDEN_MEDICA_SOPORTE_MAX_MB (default 5)." }
              ]
            },
            "url": "{{baseUrl}}/afiliados/autorizacion-orden-medica-ips",
            "description": "Paso 1 — POST /afiliados/autorizacion-orden-medica-ips.\n\nEvalúa medicamentos antes de persistir. Si **ninguno** cumple validaciones responde **400** sin crear solicitud. Si **al menos uno** autoriza: crea solicitud (TOTAL o PARCIAL) **sin** ss_autorizacion. Ejecute después *Activar y confirmar autorización IPS* con `consecutivo_solicitud`.\n\n**Prerequest:** fechas al día actual. PDF obligatorio en soporte_orden_medica."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date().toISOString().slice(0, 10);",
                  "const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "target.set('fecha_solicitud_proceso', hoy);",
                  "target.set('fecha_solicitud_medico', hoy);",
                  "if (!target.get('prioridad_atencion')) { target.set('prioridad_atencion', '1'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "  if (data.consecutivo_solicitud) {",
                  "    target.set('consecutivo_solicitud', String(data.consecutivo_solicitud));",
                  "  }",
                  "  pm.test('tipo_resultado', () => pm.expect(data.tipo_resultado).to.be.oneOf(['TOTAL', 'PARCIAL']));",
                  "  if (data.medicamentos_solicitados && data.medicamentos_solicitados.length) {",
                  "    pm.test('observacion en medicamento', () => {",
                  "      const m = data.medicamentos_solicitados[0];",
                  "      pm.expect(m).to.have.property('observacion');",
                  "    });",
                  "  }",
                  "  if (data.pin_activacion) {",
                  "    target.set('pin_activacion', data.pin_activacion);",
                  "  }",
                  "  if (data.estado_trazabilidad) {",
                  "    pm.test('estado trazabilidad solicitud', () => pm.expect(data.estado_trazabilidad).to.eql('SOLICITUD'));",
                  "  }",
                  "  if (data.pendiente_activacion !== undefined) {",
                  "    pm.test('sin autorizacion emitida', () => pm.expect(data.pendiente_activacion).to.eql(false));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Activar y confirmar autorización IPS (orden médica)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "tipo_identificacion", "value": "{{tipo_identificacion}}", "type": "text" },
                { "key": "numero_identificacion", "value": "{{numero_identificacion}}", "type": "text" },
                { "key": "consecutivo_solicitud", "value": "{{consecutivo_solicitud}}", "type": "text", "description": "integer — ss_solicitud del paso 1. Obligatorio salvo reintento con pin_activacion." },
                { "key": "pin_activacion", "value": "{{pin_activacion}}", "type": "text", "description": "Opcional. PIN devuelto en esta respuesta si ya emitió autorización.", "disabled": true },
                { "key": "nit_ips_direccionamiento", "value": "{{nit_ips_direccionamiento}}", "type": "text", "description": "Mismo NIT del paso 1." },
                { "key": "fecha_programacion", "value": "{{fecha_programacion}}", "type": "text", "description": "date — ss_autorizacion_medicamento.fecha_programacion. YYYY-MM-DD. Prerequest asigna hoy." },
                { "key": "fecha_prestacion", "value": "{{fecha_prestacion}}", "type": "text", "description": "date — ss_autorizacion.fecha_real_prestacion_servicio. YYYY-MM-DD. Prerequest asigna hoy." },
                { "key": "confirmar_prestacion", "value": "{{confirmar_prestacion}}", "type": "text", "description": "boolean — default true. Si false, solo activa (ACTIVADA) sin confirmar prestación." },
                { "key": "soporte_confirmacion", "type": "file", "src": [], "description": "PDF obligatorio en el paso 2. Repositorio Messiah autorizacion_confirmada/." }
              ]
            },
            "url": "{{baseUrl}}/afiliados/autorizacion-orden-medica-ips/activar",
            "description": "Paso 2 — POST /afiliados/autorizacion-orden-medica-ips/activar.\n\nEmite ss_autorizacion, activa (ACTIVADA), confirma prestación (COMPLETADA) por defecto, contabiliza si tb_preferencia 288 o 390 está activa, y devuelve PDF prestado en autorizacion_pdf_base64.\n\nRequiere `consecutivo_solicitud` del paso 1 (o `pin_activacion` en reintentos). **`soporte_confirmacion` PDF obligatorio.** Mismo documento y nit_ips_direccionamiento.\n\nIdempotente si ya estaba activada o confirmada."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date().toISOString().slice(0, 10);",
                  "const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "target.set('fecha_programacion', hoy);",
                  "target.set('fecha_prestacion', hoy);",
                  "if (!target.get('confirmar_prestacion')) { target.set('confirmar_prestacion', 'true'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test('autorizacion activa', () => pm.expect(data.autorizacion_activa).to.eql(true));",
                  "  const confirmar = (pm.variables.get('confirmar_prestacion') || 'true').toLowerCase() !== 'false';",
                  "  if (confirmar) {",
                  "    pm.test('prestacion confirmada', () => pm.expect(data.prestacion_confirmada).to.eql(true));",
                  "    pm.test('estado trazabilidad', () => pm.expect(data.estado_trazabilidad).to.eql('COMPLETADA'));",
                  "  } else {",
                  "    pm.test('estado trazabilidad', () => pm.expect(data.estado_trazabilidad).to.eql('ACTIVADA'));",
                  "  }",
                  "  if (data.pin_activacion) {",
                  "    const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "    target.set('pin_activacion', data.pin_activacion);",
                  "  }",
                  "  if (data.consecutivo_autorizacion) {",
                  "    const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "    target.set('consecutivo_autorizacion', String(data.consecutivo_autorizacion));",
                  "  }",
                  "  if (data.consecutivo_saldo) {",
                  "    const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "    target.set('consecutivo_saldo', String(data.consecutivo_saldo));",
                  "  }",
                  "  if (data.autorizacion_emitida !== undefined) {",
                  "    pm.test('autorizacion emitida en paso 2', () => pm.expect(data.autorizacion_emitida).to.eql(true));",
                  "  }",
                  "  if (data.pdf_generado) {",
                  "    pm.test('pdf base64', () => pm.expect(data.autorizacion_pdf_base64).to.be.a('string').and.not.empty);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
