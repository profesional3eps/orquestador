  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Emitir token JWT",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Autenticación con usuario y contraseña. Devuelve `access_token` y `expires_in`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) {",
                  "    pm.collectionVariables.set('access_token', data.access_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil y permisos (módulos / acciones)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Perfil del usuario autenticado, permisos por módulo y acciones permitidas."
          }
        }
      ]
    },
    {
      "name": "Documentación",
      "description": "OpenAPI para sincronizar tipos (date, integer) con Postman: Import → Link → pegar URL.",
      "item": [
        {
          "name": "OpenAPI JSON (importar en Postman)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json",
            "description": "Esquema OpenAPI 3. Fechas con `format: date`, enteros con `type: integer`. En Postman: Import → Link → `{{baseUrl}}/openapi.json` (con la API en ejecución). Los endpoints multipart siguen siendo Text/File en la colección manual."
          }
        }
      ]
    },
    {
