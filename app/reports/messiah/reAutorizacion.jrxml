	<property name="ireport.zoom" value="1.4641000000000055"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="915"/>
	<parameter name="RUTA" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="MANEJO_INTEGRAL" class="java.lang.String"/>
	<parameter name="CODIGO_CUPS" class="java.lang.String"/>
