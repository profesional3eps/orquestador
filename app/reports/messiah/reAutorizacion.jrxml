	<parameter name="ENTIDAD_RESPONSABLE" class="java.lang.String"/>
	<parameter name="COD_ENTIDAD_RESPONSABLE" class="java.lang.String"/>
	<parameter name="TELEFONO_USUARIO" class="java.lang.String"/>
	<parameter name="CELULAR_USUARIO" class="java.lang.String"/>
	<parameter name="NOMBRE_USUARIO" class="java.lang.String"/>
	<parameter name="ES_EMPRESA" class="java.lang.Boolean"/>
	<parameter name="NUMERO_SOLICITUD_USUARIO" class="java.lang.String"/>
	<parameter name="ITEM" class="java.lang.String"/>
	<parameter name="SR_COPAGO" class="java.lang.String"/>
	<parameter name="FECHA_HOY" class="java.util.Date"/>
	<parameter name="APLICA" class="java.lang.String"/>
	<parameter name="NO_APLICA" class="java.lang.String"/>
	<parameter name="LINEA_NACIONAL" class="java.lang.String"/>
	<parameter name="NIT_EMPRESA" class="java.lang.String"/>
	<parameter name="OBSERVACION" class="java.lang.String"/>
	<parameter name="PRESTADO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="EMPRESA" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT A.CONSECUTIVO_INTERNO AS NUMERO_AUTORIZACION,
  A.VALOR_COPAGO AS VALOR_CUOTA_MODERADORA,
  A.TIPO_COBRO AS TIPO_COBRO,
  A.FECHA_GRABADO AS FECHA_AUTORIZACION,
  A.USUARIO_GRABADO AS USUARIO_AUTORIZA,
  A.CATEGORIA_AFILIADO AS CATEGORIA_AFILIADO,
  V.VALOR AS VIGENCIA,
  A.OBSERVACION AS observacion,
  S.FECHA_SOLICITUD_MEDICO AS fecha_orden_medica,
  IPS.RAZON_SOCIAL AS NOMBRE_PRESTADOR,
  IPS.NIT AS DOCUMENTO_PRESTADOR,
  IPS.CODIGO_PRESTADOR AS CODIGO_PRESTADOR,



   case when a.consecutivo_sede is null then IPS.DIRECCION else ss.direccion end as DIRECCION_PRESTADOR,
   case when a.consecutivo_sede is null then  M.DESCRIPCION else tms.descripcion end as MUNICIPIO_PRESTADOR,
   case when a.consecutivo_sede is null then D.DESCRIPCION else tm2s.descripcion end as DEPARTAMENTO_PRESTADOR,
   case when a.consecutivo_sede is null then IPS.TELEFONO else ss.telefono end as TELEFONO_PRESTADOR,
   case when a.consecutivo_sede is null then IPS.TELEFONO else ss.telefono end as call_center,

	case when   A.tipo_regimen_afiliado  = 99 then 'RÉGIMEN SUBSIDIADO' ELSE 'RÉGIMEN CONTRIBUTIVO' end REGIMEN,




  A.PRIMER_NOMBRE_AFILIADO AS NOMBRE1_PACIENTE,
  A.SEGUNDO_NOMBRE_AFILIADO AS NOMBRE2_PACIENTE,
  A.PRIMER_APELLIDO_AFILIADO AS APELLIDO1_PACIENTE,
  A.SEGUNDO_APELLIDO_AFILIADO AS APELLIDO2_PACIENTE,
  A.TIPO_IDENTIFICACION_AFILIADO AS TIPO_DOCUMENTO_PACIENTE,
  A.NUMERO_IDENTIFICACION_AFILIADO AS NUMERO_DOCUMENTO_PACIENTE,
  A.FECHA_NACIMIENTO_AFILIADO AS FECHA_NACIMIENTO_PACIENTE,
  A.DIRRECCION_AFILIADO AS DIRECCION_PACIENTE,
  A.TELEFONO_AFILIADO AS TELEFONO1_PACIENTE,
  DAF.DESCRIPCION AS DEPARTAMENTO_PACIENTE,
  MAF.DESCRIPCION AS MUNICIPIO_PACIENTE,
  A.CELULAR_AFILIADO AS CELULAR_PACIENTE,
  A.EMAIL_AFILIADO AS CORREO_PACIENTE,
  S.UBICACION_PACIENTE AS UBICACION_PACIENTE,
  S.INDICADOR_SOLICITUD AS INDICADOR_ORIGEN,
  S.MANEJO_INTEGRAL AS MANEJO_INTEGRAL,
  S.SERVICIO AS NOMBRE_SERVICIO,
  S.NUMERO_SOLICITUD AS NUMERO_SOLICITUD,
  S.CAMA AS CAMA_SERVICIO,
  S.FECHA_GRABADO AS FECHA_SOLICITUD,
  cip.NIT AS NIT_SOLICITANTE,
  S.SW_POS AS POS,
cip.RAZON_SOCIAL AS NOMBRE_IPS_SOLICITANTE,
  DIAG.SIMBOLO AS DIAGNOSTICO,
  TUT.RADICADO_TUTELA,
  CTCMIP.CODIGO_INTERNO_CTC,
  S.TIPO_REGIMEN_AFILIADO AS TIPO_REGIMEN_COBERTURA,
  AF.tipo_afiliado as tipoAfiliado,
  A.SW_ORDEN_SERVICIO as ordenServicio,
com.serial_fosyga,
A.afiliado,
a.pin codigoactivacion,
a.fecha_fin_vigencia as fecha_vencimiento,
concat(A.PRIMER_NOMBRE_AFILIADO, ' ', A.SEGUNDO_NOMBRE_AFILIADO, ' ',  A.PRIMER_APELLIDO_AFILIADO, ' ', A.SEGUNDO_APELLIDO_AFILIADO) as nombre_completoAf,
case when AF.sexo = '1' then 'Masculino' else 'Femenino' end as sexo,


	   case when S.sede_solicitante is null then cip.direccion else sss.direccion end as direccionIpsSolicitante,
	   case when S.sede_solicitante is null then tms.descripcion else tm2s.descripcion end as descripcionSolicitante,
	   case when S.sede_solicitante is null then concat(tms.descripcion, '/', tm2s.descripcion) else concat(tmIpsSol.descripcion, '/', tm3.descripcion) end as municipioIpsSolicitante,
	   case when S.sede_solicitante is null then cip.telefono else sss.telefono end as telefonoIpsSolicitante,
	   case when S.sede_solicitante is null then cip.call_center else sss.telefono end as call_center_solicitante,


CASE
    WHEN AF.tipo_afiliado = 3 THEN 'Cotizante'
    WHEN AF.tipo_afiliado = 2 THEN 'Beneficiario'
    WHEN AF.tipo_afiliado = 4 THEN 'Adicional'
    WHEN AF.tipo_afiliado = 5 THEN 'Aportante'
    WHEN AF.tipo_afiliado = 1 THEN 'Cabeza Familia'
    WHEN AF.tipo_afiliado = 6 THEN 'Contribución Solidaria'
    ELSE 'Desconocido'
END AS tipo_afiliado_descripcion,
dis.descripcion as descripcion_discapacidad,
gru.descripcion as grupo_poblacional,
CASE
    WHEN AF.estrato = 1 THEN '1'
    WHEN AF.estrato = 2 THEN '2'
    WHEN AF.estrato = 3 THEN '3'
    WHEN AF.estrato = 4 THEN '4'
    WHEN AF.estrato = 5 THEN '5'
    WHEN AF.estrato = 5 THEN '6'
    ELSE 'Desconocido'
END AS estrato,
S.fecha_solicitud_medico as fecha_orden_medica,
CASE
    WHEN A.tipo_proceso = 1 THEN 'Autorizaciones'
    WHEN A.tipo_proceso = 2 THEN 'Ordenes de Servicio'
    WHEN A.tipo_proceso = 3 THEN 'Ordenes de Cotización'
    ELSE 'Desconocido'
END AS tipo_autorizacion,
CASE
    WHEN S.ubicacion_paciente = 1 THEN 'Ambulatorio'
    WHEN S.ubicacion_paciente = 2 THEN 'Urgencias'
    WHEN S.ubicacion_paciente = 3 THEN 'Hospitalización'
    WHEN S.ubicacion_paciente = 4 THEN 'Domiciliario'
    ELSE 'Desconocido'
END AS ubicacion_paciente_descripcion,
COALESCE(NULLIF(TRIM(concat(COALESCE(u.nombre,''), ' ', COALESCE(u.apellido,''))), ''), a.usuario_grabado) as usuarioGNombres,
a.observacion
  FROM administrativo.ss_autorizacion A
  INNER JOIN administrativo.tb_preferencia V
  ON V.CONSECUTIVO_PREFERENCIA = A.VIGENCIA
  LEFT JOIN administrativo.ss_solicitud S
  ON A.CONSECUTIVO_SOLICITUD = S.CONSECUTIVO_SOLICITUD
  LEFT JOIN administrativo.ss_tutela TUT
  ON TUT.CONSECUTIVO_TUTELA = S.CONSECUTIVO_TUTELA
  LEFT JOIN administrativo.ss_ctc CTCMIP
  ON CTCMIP.CONSECUTIVO_CTC = S.CONSECUTIVO_CTC
  LEFT JOIN administrativo.ct_ips IPS
  ON IPS.IPS = A.CONSECUTIVO_IPS
  LEFT JOIN administrativo.tb_municipio M
  ON A.MUNICIPIO_PRESTADOR = M.MUNICIPIO
  LEFT JOIN administrativo.tb_municipio D
  ON M.DEPARTAMENTO = D.MUNICIPIO

   left join administrativo.ct_ips_sede ss on a.consecutivo_sede = ss.consecutivo_sede_ips
        left join administrativo.ct_ips_sede sss on S.sede_solicitante = sss.consecutivo_sede_ips
   left join administrativo.tb_municipio tms on tms.municipio = ss.municipio
   left join administrativo.tb_municipio tm2s on tms.departamento = tm2s.municipio


  LEFT JOIN administrativo.af_afiliado AF
  ON A.AFILIADO = AF.AFILIADO
  LEFT JOIN administrativo.tb_municipio MAF
  ON S.MUNICIPIO_AFILIADO = MAF.MUNICIPIO
  LEFT JOIN administrativo.tb_municipio DAF
  ON MAF.DEPARTAMENTO = DAF.MUNICIPIO
  LEFT JOIN administrativo.tb_cie10 DIAG
  ON S.DIAGNOSTICO_PRINCIPAL = DIAG.CIE_10
  inner join administrativo.af_afiliado_complemento com on com.afiliado =AF.afiliado
  left join administrativo.ct_ips cip on cip.ips = s.ips_solicitante
  left join administrativo.tb_municipio tmIpsSol on tmIpsSol.municipio = ss.municipio
  left join administrativo.tb_municipio tm3 on tm3.municipio = tmIpsSol.departamento
  left join administrativo.usuario u on u.usuario = a.usuario_grabado
  inner join administrativo.tb_discapacidad dis on AF.discapacidad = dis.discapacidad
  left join administrativo.tb_grupo_poblacional gru on AF.grupo_poblacional = gru.grupo_poblacional
  WHERE A.CONSECUTIVO_AUTORIZACION = $P!{AUTORIZACION}]]>
	</queryString>
