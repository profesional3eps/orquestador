<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ssActivacion" pageWidth="612" pageHeight="792" columnWidth="522" leftMargin="45" rightMargin="45" topMargin="20" bottomMargin="20" uuid="a58b0a15-a1e9-49e0-971d-b43ccb4187ff">
	<property name="ireport.zoom" value="1.3310000000000068"/>
	<property name="ireport.x" value="65"/>
	<property name="ireport.y" value="273"/>
	<parameter name="CONSECUTIVO" class="java.lang.String"/>
	<parameter name="RUTA" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/home/system/Escritorio/reportes jasper/"]]></defaultValueExpression>
	</parameter>
	<parameter name="EMPRESA" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.pin as codigoActivacion,
       a.numero_identificacion_afiliado,
       a.tipo_identificacion_afiliado,
       a.razon_social_prestador,
       a.nit_prestador,
	   case when a.consecutivo_sede is null then ci.direccion else s.direccion end as direccion,
	   case when a.consecutivo_sede is null then tm.descripcion else tms.descripcion end as descripcion,
	   case when a.consecutivo_sede is null then concat(tm.descripcion, '/', tm2.descripcion) else concat(tms.descripcion, '/', tm2s.descripcion) end as municipio,
	   case when a.consecutivo_sede is null then ci.telefono else s.telefono end as telefono,
	   case when a.consecutivo_sede is null then ci.call_center else s.telefono end as call_center,

       concat(a.primer_nombre_afiliado, ' ', coalesce(a.segundo_nombre_afiliado,''), ' ', a.primer_apellido_afiliado, ' ',
       coalesce(a.segundo_apellido_afiliado, ''))  as afiliado,
       cie10.simbolo as diagnostico,
       a.usuario_grabado,
       a.fecha_grabado,
       com.serial_fosyga,
       a.afiliado llave_afiliado,
       a.fecha_fin_vigencia as fecha_vencimiento,
       a.fecha_nacimiento_afiliado,
       cip.nit,
       case when com.tipo_regimen = '1' then 'Régimen Contributivo' else 'Régimen Subsidiado' end as regimen,
       case when af.sexo = '1' then 'Masculino' else 'Femenino' end as sexo,

       cip.direccion as direccionIpsSolicitante,
       case when cip.telefono is null then sol.telefono_institucional_telefono else cip.telefono end as telefonoIpsSolicitante,
       concat (tmIpsSol.descripcion, '/', tm3.descripcion) as municipioIpsSolicitante,
       cip.nit as nitIpsSolicitante,
       cip.razon_social as razonIpsSolicitante,
       concat(u.nombre,' ', u.apellido) as usuarioGNombres,
       a.observacion
from administrativo.ss_autorizacion a
     left join administrativo.ct_ips ci on ci.ips = a.consecutivo_ips
     left join administrativo.tb_municipio tm on tm.municipio = a.municipio_prestador
     left join administrativo.tb_municipio tm2 on tm2.municipio = tm.departamento
     left join administrativo.ss_solicitud sol on sol.consecutivo_solicitud = a.consecutivo_solicitud
     left join administrativo.ct_ips cip on cip.ips = sol.ips_solicitante
     left join administrativo.tb_cie10 cie10 on cie10.cie_10 = sol.diagnostico_principal
     left join administrativo.ct_ips_sede s on a.consecutivo_sede = s.consecutivo_sede_ips
     left join administrativo.tb_municipio tms on tms.municipio = s.municipio
     left join administrativo.tb_municipio tm2s on tms.departamento = tm2s.municipio
     inner join administrativo.af_afiliado_complemento com on com.afiliado = a.afiliado
     inner join administrativo.af_afiliado af on af.afiliado = a.afiliado
     left join administrativo.tb_municipio tmIpsSol on tmIpsSol.municipio = cip.municipio
     left join administrativo.tb_municipio tm3 on tm3.municipio = tmIpsSol.departamento
     left join administrativo.usuario u on u.usuario = a.usuario_grabado
where a.consecutivo_autorizacion = $P!{CONSECUTIVO}]]>
	</queryString>
