	<parameter name="MANEJO_INTEGRAL" class="java.lang.String"/>
	<parameter name="CODIGO_CUPS" class="java.lang.String"/>
	<parameter name="CANTIDAD" class="java.lang.String"/>
	<parameter name="DESCRIPCION" class="java.lang.String"/>
	<parameter name="AUTORIZACION" class="java.lang.String"/>
	<parameter name="ITEM" class="java.lang.String"/>
	<parameter name="SR_COPAGO" class="java.lang.String"/>
	<parameter name="APLICA" class="java.lang.String"/>
	<parameter name="NO_APLICA" class="java.lang.String"/>
	<parameter name="OBSERVACION" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ROW_NUMBER() OVER(ORDER BY CONSECUTIVO_AUTORIZACION DESC) AS CONSECUTIVO_AUTORIZACION, T1.*
FROM (
SELECT AUC.CONSECUTIVO_AUTORIZACION, AC.VALOR_COPAGO, AC.VALOR_AUTORIZA, S.MANEJO_INTEGRAL, TC.CODIGO_INTERNO AS CODIGO, AC.DESCRIPCION_CODIGO_PROPIO AS DESCRIPCION, AC.CANTIDAD AS CANTIDAD, AC.OBSERVACION_AUTORIZACION AS OBSERVACION, AC.DESCRIPCION_CODIGO_PAQUETE AS PAQUETE
  FROM administrativo.ss_autorizacion AUC
  LEFT JOIN administrativo.ss_solicitud S
  ON AUC.CONSECUTIVO_SOLICITUD=S.CONSECUTIVO_SOLICITUD
  LEFT JOIN administrativo.ss_autorizacion_cup AC
  ON AUC.CONSECUTIVO_AUTORIZACION=AC.CONSECUTIVO_AUTORIZACION
  LEFT JOIN administrativo.tb_cup TC
  ON AC.CUP=TC.CUP
  WHERE AUC.CONSECUTIVO_AUTORIZACION=$P!{AUTORIZACION}
  UNION ALL
  SELECT AUI.CONSECUTIVO_AUTORIZACION, AI.VALOR_COPAGO, AI.VALOR_AUTORIZA, S.MANEJO_INTEGRAL, TI.CODIGO_INTERNO AS CODIGO, AI.DESCRIPCION_CODIGO_PROPIO AS DESCRIPCION, AI.CANTIDAD AS CANTIDAD, AI.OBSERVACION_AUTORIZACION AS OBSERVACION, AI.DESCRIPCION_CODIGO_PAQUETE AS PAQUETE
  FROM administrativo.ss_autorizacion AUI
  LEFT JOIN administrativo.ss_solicitud S
  ON AUI.CONSECUTIVO_SOLICITUD=S.CONSECUTIVO_SOLICITUD
  LEFT JOIN administrativo.ss_autorizacion_insumo AI
  ON AUI.CONSECUTIVO_AUTORIZACION=AI.CONSECUTIVO_AUTORIZACION
  LEFT JOIN administrativo.tb_insumo TI
  ON AI.INSUMO=TI.INSUMO
  WHERE AUI.CONSECUTIVO_AUTORIZACION=$P!{AUTORIZACION}
  UNION ALL
  SELECT AUM.CONSECUTIVO_AUTORIZACION, AM.VALOR_COPAGO, AM.VALOR_AUTORIZA, S.MANEJO_INTEGRAL, TM.CODIGO_INTERNO AS CODIGO, AM.DESCRIPCION_CODIGO_PROPIO AS DESCRIPCION, AM.CANTIDAD AS CANTIDAD, AM.OBSERVACION_AUTORIZACION AS OBSERVACION, AM.DESCRIPCION_CODIGO_PAQUETE AS PAQUETE
  FROM administrativo.ss_autorizacion AUM
  LEFT JOIN administrativo.ss_solicitud S
  ON AUM.CONSECUTIVO_SOLICITUD=S.CONSECUTIVO_SOLICITUD
  LEFT JOIN administrativo.ss_autorizacion_medicamento AM
  ON AUM.CONSECUTIVO_AUTORIZACION=AM.CONSECUTIVO_AUTORIZACION
  LEFT JOIN administrativo.tb_medicamento TM
  ON AM.MEDICAMENTO=TM.MEDICAMENTO
  WHERE AUM.CONSECUTIVO_AUTORIZACION=$P!{AUTORIZACION}
) t1
where t1.CODIGO is not null]]>
	</queryString>
